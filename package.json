{
  "name": "i18n-string-reviewer",
  "version": "0.1.0",
  "private": true,
  "description": "Review-only localisation string checker: deterministic rules, masked model review, gated fixes.",
  "license": "MIT",
  "author": "Roy Harden",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx scripts/demo.ts",
    "eval": "tsx scripts/eval.ts",
    "make-split": "tsx scripts/make-split.ts",
    "sync:function": "tsx scripts/sync-function-shared.ts",
    "syntax-check": "node scripts/syntax-check.mjs ."
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "2.7.8",
    "@supabase/supabase-js": "2.45.4",
    "jsonc-parser": "3.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "9.14.0",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "eslint": "9.14.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.14",
    "globals": "15.12.0",
    "jsdom": "25.0.1",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.13.0",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
